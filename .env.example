# Copia questo file in .env (che non finisce su GitHub) per usare KeepGoing sul computer.
# Su GitHub Actions gli stessi valori vanno nei "secrets" del repository.

# Fonte dei prezzi
TRAVELPAYOUTS_TOKEN=
SERPAPI_KEY=

# Notifiche all'app iPhone (Apple Push Notification service)
# In locale indica il percorso del file .p8 (es. AuthKey_ABC123DEFG.p8).
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_DEVICE_TOKENS=
APNS_ENVIRONMENT=

# Canali extra facoltativi
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NTFY_TOPIC=
